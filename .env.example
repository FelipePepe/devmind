# ─────────────────────────────────────────────────────────────
# Bootstrap Infisical (ÚNICAS variables reales aquí)
# Obtén clientId/clientSecret con: casa vault init devmind
# ─────────────────────────────────────────────────────────────
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_SITE_URL=http://infisical.casa

# ─────────────────────────────────────────────────────────────
# El resto de secretos viven en Infisical → http://infisical.casa
# Proyecto: devmind  |  slug: devmind-pxgt
# ─────────────────────────────────────────────────────────────

# Backend (referencia — añadir en Infisical)
# PORT=3001
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CODING_MODEL=qwen2.5-coder:7b
# OLLAMA_REASONING_MODEL=qwen3:latest
# OLLAMA_VISION_MODEL=qwen2.5-vl:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# DEVMIND_API_KEY=
# WORKSPACE_ROOT=./workspace
# VECTOR_DB_PATH=./data/vectors
# SQLITE_PATH=./data/checkpoints.db
# LOG_LEVEL=info
# MAX_TOOL_TIMEOUT_MS=30000
# ALLOWED_SHELL_COMMANDS=git,npm,pnpm,node,tsc,eslint,jest,vitest,rg,grep

# Firebase Admin (backend — añadir en Infisical)
# FIREBASE_PROJECT_ID=tu-proyecto-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=tu-proyecto-id.firebasestorage.app
# FIREBASE_USE_EMULATOR=true
# FIREBASE_EMULATOR_HOST=localhost
# FCM_SERVER_KEY=
# REMOTE_CONFIG_CACHE_TTL_MS=300000

# Frontend (referencia — añadir en Infisical con prefijo VITE_)
# VITE_BACKEND_URL=http://localhost:3001
# VITE_APP_TITLE=DevMind
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
# VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-id.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abc123
# VITE_FIREBASE_USE_EMULATOR=true
