FROM node:22-alpine AS base
RUN apk add --no-cache python3 make g++
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/workers/package.json ./packages/workers/
RUN pnpm install --frozen-lockfile --filter @devmind/workers...

FROM base AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/workers/node_modules ./packages/workers/node_modules
COPY . .
RUN pnpm --filter @devmind/workers build

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache dumb-init

COPY --from=build /app/packages/workers/dist ./dist
COPY --from=build /app/packages/workers/package.json ./package.json
COPY --from=deps /app/packages/workers/node_modules ./node_modules

RUN mkdir -p /app/data /app/workspace

ENV NODE_ENV=production

USER node
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]
