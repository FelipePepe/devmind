{
  "name": "devmind",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @devmind/backend --filter @devmind/frontend dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" --max-warnings 9999",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:llm": "DEVMIND_E2E_RUN_LLM=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^9.18.0",
    "otpauth": "^9.5.1",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "hnswlib-node"
    ]
  }
}
